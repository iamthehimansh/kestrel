{
  "name": "BGMI / PUBG Mobile (FPP/TPP default HUD)",
  "package": "com.pubg.imobile",
  "description": "WASD move, mouse look (` toggles), LMB fire, RMB scope, Alt frees cursor. Adjust positions with `kestrel keymap edit` if you use a custom HUD.",
