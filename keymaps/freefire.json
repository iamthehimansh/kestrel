    {"type": "tap", "key": "2", "at": [0.56, 0.9], "label": "Weapon 2"},
    {"type": "tap", "key": "3", "at": [0.5, 0.9], "label": "Melee"},
    {"type": "tap", "key": "4", "at": [0.33, 0.9], "label": "Medkit"},
    {"type": "tap", "key": "Tab", "at": [0.06, 0.07], "label": "Bag"},
    {"type": "tap", "key": "M", "at": [0.9, 0.12], "label": "Map"},
    {"type": "tap", "key": "Escape", "at": [0.965, 0.04], "label": "Settings"},
